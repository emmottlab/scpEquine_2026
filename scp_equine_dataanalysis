# Define and perform linear modeling - based on run, reporter, median intensity, and celltype
sce <- scpModelWorkflow(
  sce,
  formula = ~ 1 + ## intercept
    ## normalization
    MedianIntensity +
    ## batch effects
    quantCols + runCol + 
    ## biological variability
   CellType
)


