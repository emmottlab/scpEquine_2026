unique(head(mqSCPdata$Raw.file))


head(samples)
colnames(samples)
head(samples$Well)

#Extract the well  
samples$Well <- sub(".*W([A-Z][0-9]+)_.*", "\\1", samples$runCol)

samples$runCol <- paste0(
  "20260323_QeXHF-UM3000SC_CPR_MaLo_SA_",
  samples$Well
)


samples$Raw.file <- samples$runCol

scp <- scp::readSCP(
  assayData = mqSCPdata,
  colData = samples,
  runCol = "Raw.file"
)

head(scp)
View(scp)

# Replace 0 with NA
scp <- zeroIsNA(scp, i = names(scp))

  
# Compute Sample to carrier ratio
  scp <- computeSCR(
    scp, names(scp), 
    colvar = "CellType", 
    samplePattern = "ASC2|ASC3|ASC8|ASC10|ASC11|ASC13|ASC17", 
    carrierPattern = "Carrier",
    sampleFUN = "mean", 
    rowDataName = "MeanSCR"
  )

#Plot Sample-to-Carrier Ratio 
pMinProc1 <- ggplot(as.data.frame(rowData(scp[[1]]))) +
  aes(x = MeanSCR) +
  geom_histogram(bins = 50, alpha = 0.8, fill = "grey", color = "black") +
  geom_vline(xintercept = c(1/200, 0.2),
             lty = c(2, 1),
             color = "red",
             linewidth = 1) +
  scale_x_log10(
    breaks = c(10, 1, 0.1, 0.01,0.001), # Define where tick marks appear
    #    labels = label_number()        # Use decimal notation for labels
  ) +
  labs(
    x = expression(paste("Mean SCR (log"["10"], " )")), # Use expression for subscript
    y = "Frequency") +
  theme_classic(base_size = 16)

pMinProc1

colnames(rowData(scp))


# Apply filter   
scp <- filterFeatures(
  scp, ~ Reverse != "+" &
    Potential.contaminant != "+" &
    !grepl("REV|CON", Leading.razor.protein) &
    !is.na(PIF) & PIF > 0.6 &
    #dart_qval < 0.01 &
    PEP < 0.01 &
    !is.na(MeanSCR) & MeanSCR < 0.2
)

# Count number of peptides
scp <- countUniqueFeatures(
  scp, i = names(scp), groupBy = "Sequence",
  colDataName = "NumberPeptides"
)


# Plot No' peptides as raincloud plot and visualise cutoff
pMinProc2 <-  colData(scp) |>
  data.frame() |>
  ggplot() + aes(x = CellType, 
                 y = NumberPeptides, 
                 fill = CellType) +
  geom_rain() +
  scale_fill_viridis_d() + labs(x = "Cell Type",
     y = "Number of Peptides"
) +
  geom_hline(yintercept = 650, 
             color = "red", 
             linetype = "dashed",
             linewidth = 1) +
  theme_classic(base_size = 16) +
  theme(legend.position = "none") 

pMinProc2

# Calc median intensity
MedianIntensity <- lapply(experiments(scp), function(x) {
  out <- colMedians(log(assay(x)), na.rm = TRUE)
  names(out) <- colnames(x)
  out
})

names(MedianIntensity) <- NULL
MedianIntensity <- unlist(MedianIntensity)
colData(scp)[names(MedianIntensity), "MedianIntensity"] <- MedianIntensity

# Plot median intensity as boxplot and visualise min and max cutoffs
pMinProc3 <- colData(scp) |>
  data.frame() |>
  ggplot() +
  aes(x = MedianIntensity,
      y = CellType,
      fill = CellType) +
  geom_boxplot(alpha = 0.7, outlier.shape = NA) +
  geom_vline(xintercept = c(6.2, 6.9), 
             color = "red", 
             linetype = "dashed",
             linewidth = 1) +
  labs(
    x = "Median Reporter Ion Intensity",
    y = "Cell Type") +
  scale_fill_viridis_d() +
  theme_classic(base_size = 16) +
  theme(legend.position = "none")

pMinProc3


# Calc median CV per cell
scp <- medianCVperCell(
  scp, i = names(scp), groupBy = "Leading.razor.protein",
  nobs = 3, na.rm = TRUE, colDataName = "MedianCV", norm = "SCoPE2"
)

pMinProc4 <-  colData(scp) |>
  data.frame() |>
  ggplot() +
  aes(x = MedianCV,
      y = CellType,
      fill = CellType) +
  geom_boxplot(alpha = 0.7, outlier.shape = NA) + 
  geom_vline(xintercept = c(0.35, 0.48), 
