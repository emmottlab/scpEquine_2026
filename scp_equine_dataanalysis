             linetype = "dashed",
             linewidth = 1) +
  labs(
    x = "Median CV per Cell",
    y = "Cell Type") +
  theme_classic(base_size = 16) +
  scale_fill_viridis_d() +
  theme(legend.position = "none")

pMinProc4


# Now filter based on the above cutoffs
passQC <- !is.na(scp$MedianCV) & scp$MedianCV > 0.35 & scp$MedianCV < 0.48 &
  scp$MedianIntensity > 6.2 & scp$MedianIntensity < 6.9 &
  scp$NumberPeptides > 1100 &
  grepl("ASC2|ASC3|ASC8|ASC10|ASC11|ASC13|ASC17", scp$CellType)

scp <- subsetByColData(scp, passQC)

# Now some housekeeping - to clear out poor/empty assays after filtering
# Keep assays with 4+ cells passing QC
keepAssay <- dims(scp)[2, ] > 3
scp <- scp[, , keepAssay]

# Now keep assays with 300+ peptides passing QC
keepAssay <- dims(scp)[1, ] > 300
scp <- scp[, , keepAssay]


# Aggregate PSMs to peptides
peptideAssays <- paste0("peptides_", names(scp))
scp <- aggregateFeatures(scp,
                         i = names(scp),
                         fcol = "Sequence",
                         name = peptideAssays,
                         fun = colMedians,
                         na.rm = TRUE)



# Now join peptide assays to a single assay
scp <- joinAssays(scp, i = peptideAssays, 
                  name = "peptides")

# Log-transform peptide data
scp <- logTransform(scp, i = "peptides", name = "peptides_log")

# Missing value reporting section
# Missing value reporting
reportMissingValues(scp, "peptides", by = scp$CellType)

# Calc JI
ji <- jaccardIndex(scp, "peptides", by = scp$CellType)

pRep1 <- ggplot(ji) +
  aes(x = jaccard) +
  geom_histogram(alpha = 0.8, fill = "grey", color = "black") +
  facet_grid(~ by) +
  # xlim(0, 1) + 
  labs(x = "Jaccard Index",
       y = "Frequency") +
  theme_classic(base_size = 16) +
  theme(panel.spacing.x = unit(2, "lines")) +
  scale_x_continuous(
    limits = c(0, 1), # Sets the axis range, replacing xlim()
    breaks = c(0, 0.25, 0.5, 0.75, 1.0), # Specify exact tick mark locations
    #   labels = label_number(accuracy = 0.01) # Formats labels to 2 decimal places, but is smart about trailing zeros
  )

pRep1

