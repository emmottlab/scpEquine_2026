samples$BreedSpecific[samples$CellType == "ASC11"] <- "Warmblood"
samples$BreedSpecific[samples$CellType == "ASC10"] <- "Thoroughbred"
samples$BreedSpecific[samples$CellType == "ASC13"] <- "Warmblood"
samples$BreedSpecific[samples$CellType == "ASC17"] <- "Welsh Cob"

samples$BreedGeneral[samples$CellType %in% c("ASC2", "ASC3", "ASC17")] <- "Native"
